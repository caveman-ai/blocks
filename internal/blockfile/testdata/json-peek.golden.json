{
  "header": {
    "Name": "json-peek",
    "Summary": "Shape of a JSON or JSONL file: keys, row count, one sample. Never the data.",
    "Effects": "read",
    "Example": [
      "--path",
      "$FIXTURES/sample.json",
      "--depth",
      "1"
    ],
    "Matches": [
      "json\\.loads?\\(",
      "JSON\\.parse\\("
    ],
    "Returns": {
      "Keys": [
        "kind",
        "keys",
        "rows",
        "sample",
        "truncated"
      ],
      "Doc": "kind is object|array|jsonl; keys are top-level; sample is one element"
    },
    "Params": [
      {
        "Name": "path",
        "Type": "path",
        "Required": true,
        "Default": null,
        "Help": "JSON or JSONL file inside the repo",
        "Min": null,
        "Max": null,
        "Values": null
      },
      {
        "Name": "depth",
        "Type": "int",
        "Required": false,
        "Default": 2,
        "Help": "How deep to walk nested keys",
