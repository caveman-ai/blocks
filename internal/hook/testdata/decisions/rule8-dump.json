[
  {
    "name": "cat of a json file names installed json-peek",
    "cfg": {"repo_root": "/repo", "blocks": [{"name": "json-peek", "effects": "read", "installed": true, "hint": "caveman-blocks run json-peek --path <path>"}]},
    "input": {"command": "cat data/a.json", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "json"},
    "expect": {"hint": "Blocks: json-peek covers this. Next time: caveman-blocks run json-peek --path <path>", "events": [{"kind": "hint", "block": "json-peek"}]}
  },
  {
    "name": "jsonl prefers jsonl-stats when both are installed",
    "cfg": {"repo_root": "/repo", "blocks": [
      {"name": "json-peek", "effects": "read", "installed": true, "hint": "caveman-blocks run json-peek --path <path>"},
      {"name": "jsonl-stats", "effects": "read", "installed": true, "hint": "caveman-blocks run jsonl-stats --path <path>"}]},
    "input": {"command": "head -n 50 events.jsonl", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "jsonl"},
    "expect": {"hint": "Blocks: jsonl-stats covers this. Next time: caveman-blocks run jsonl-stats --path <path>", "events": [{"kind": "hint", "block": "jsonl-stats"}]}
  },
  {
    "name": "ndjson falls back to json-peek when it is the only one installed",
    "cfg": {"repo_root": "/repo", "blocks": [{"name": "json-peek", "effects": "read", "installed": true, "hint": "caveman-blocks run json-peek --path <path>"},
                                             {"name": "jsonl-stats", "effects": "read", "installed": false}]},
    "input": {"command": "tail events.ndjson", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "ndjson"},
    "expect": {"hint": "Blocks: json-peek covers this. Next time: caveman-blocks run json-peek --path <path>", "events": [{"kind": "hint", "block": "json-peek"}]}
  },
  {
    "name": "a log dump with first-error not installed suggests adding it",
    "cfg": {"repo_root": "/repo"},
    "input": {"command": "less build.log", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "log"},
    "expect": {"hint": "Blocks: first-error covers this. Add it with: caveman-blocks add first-error", "events": [{"kind": "hint", "block": "first-error"}]}
  },
  {
    "name": "the add suggestion is made once per session",
    "cfg": {"repo_root": "/repo"},
    "input": {"command": "cat build.log", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "log"},
    "cache": {"add_hinted": ["first-error"]},
    "expect": {"hint": "", "events": null}
  },
  {
    "name": "csv is covered by jsonl-stats",
    "cfg": {"repo_root": "/repo", "blocks": [{"name": "jsonl-stats", "effects": "read", "installed": true, "hint": "caveman-blocks run jsonl-stats --path <path>"}]},
    "input": {"command": "cat sales.csv", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "csv"},
    "expect": {"hint": "Blocks: jsonl-stats covers this. Next time: caveman-blocks run jsonl-stats --path <path>", "events": [{"kind": "hint", "block": "jsonl-stats"}]}
  },
  {
    "name": "a match hint wins over a dump hint; hints do not stack",
    "cfg": {"repo_root": "/repo", "blocks": [
      {"name": "json-peek", "effects": "read", "installed": true, "hint": "caveman-blocks run json-peek --path <path>"},
      {"name": "loc", "effects": "read", "installed": true, "matches": ["os\\.walk"], "hint": "caveman-blocks run loc"}]},
    "input": {"command": "cat a.json; python3 -c 'import os; os.walk(1)'", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "json", "extract": {"body": "import os; os.walk(1)", "lines": 1}},
    "expect": {"hint": "Blocks: loc covers this. Next time: caveman-blocks run loc", "events": [{"kind": "hint", "block": "loc"}]}
  },
  {
    "name": "a short unmatched script still lets the dump rule hint",
    "cfg": {"repo_root": "/repo", "blocks": [{"name": "json-peek", "effects": "read", "installed": true, "hint": "caveman-blocks run json-peek --path <path>"}]},
    "input": {"command": "cat a.json && python3 -c 'print(1)'", "cwd": "/repo", "session": "s1"},
    "stub": {"dump": "json", "extract": {"body": "print(1)", "lines": 1}},
    "expect": {"hint": "Blocks: json-peek covers this. Next time: caveman-blocks run json-peek --path <path>", "events": [{"kind": "hint", "block": "json-peek"}]}
  }
]
