# hooks install, status and uninstall against a temporary HOME; a binary in an npx cache is refused.
env HOME=$WORK/home XDG_STATE_HOME=$WORK/state
mkdir home/.claude

exec caveman-blocks hooks status
stdout '^claude-code: not installed'
! stdout codex

exec caveman-blocks hooks install
stdout '^binary: .*/home/.local/share/caveman-blocks/bin/caveman-blocks \(copied\)$'
stdout '^claude-code: installed in ~/.claude/settings.json$'
stdout 'trusted in an interactive session'
! stdout 'codex|cursor'
exists home/.local/share/caveman-blocks/bin/caveman-blocks
grep '/home/.local/share/caveman-blocks/bin/caveman-blocks hook --harness claude' home/.claude/settings.json

exec caveman-blocks hooks status
stdout '^claude-code: installed, runs .*/home/.local/share/caveman-blocks/bin/caveman-blocks$'
exec caveman-blocks hooks status --json
stdout '"name":"claude-code","installed":true,"binary":".*/home/.local/share/caveman-blocks/bin/caveman-blocks","binary_present":true,"config":"~/.claude/settings.json"'

exec caveman-blocks hooks install
stdout '\(unchanged\)$'
stdout '^claude-code: unchanged'

# Naming a harness installs it even when it is not detected.
exec caveman-blocks hooks install --harness codex
stdout '^codex: installed in ~/.codex/hooks.json$'
stdout 'open /hooks in Codex'
exec caveman-blocks hooks install --harness opencode
stdout '^opencode: installed in ~/.config/opencode/plugins/caveman-blocks.js$'
stdout 'loads the plugin on its next start'
exec caveman-blocks hooks install --harness pi
stdout '^pi: installed in ~/.pi/agent/extensions/caveman-blocks.js$'
stdout 'loads the extension on its next start'
grep '^// .*/home/.local/share/caveman-blocks/bin/caveman-blocks hook --harness generic$' home/.pi/agent/extensions/caveman-blocks.js
exec caveman-blocks hooks install --harness pi
stdout '^pi: unchanged'
exec caveman-blocks hooks status --harness pi
stdout '^pi: installed, runs .*/home/.local/share/caveman-blocks/bin/caveman-blocks$'
! exec caveman-blocks hooks install --harness nope
stderr 'unknown --harness'

exec caveman-blocks hooks uninstall --harness pi
stdout '^pi: removed from ~/.pi/agent/extensions/caveman-blocks.js$'
! exists home/.pi/agent/extensions/caveman-blocks.js
exec caveman-blocks hooks uninstall
stdout '^claude-code: removed from ~/.claude/settings.json$'
! grep 'caveman-blocks' home/.claude/settings.json
exec caveman-blocks hooks status
stdout '^claude-code: not installed'

# CLAUDE_CONFIG_DIR and CODEX_HOME move the harness's config; install, status and uninstall follow.
env CLAUDE_CONFIG_DIR=$WORK/max5 CODEX_HOME=$WORK/codexhome
mkdir max5
rm home/.claude
exec caveman-blocks hooks install
stdout '^claude-code: installed in .*/max5/settings.json$'
! stdout codex
grep 'caveman-blocks hook --harness claude' max5/settings.json
! exists home/.claude
exec caveman-blocks hooks install --harness codex
stdout '^codex: installed in .*/codexhome/hooks.json$'
exists codexhome/hooks.json
exec caveman-blocks hooks status --json
stdout '"name":"claude-code","installed":true,.*"config":".*/max5/settings.json"'
stdout '"name":"codex","installed":true,.*"config":".*/codexhome/hooks.json"'
exec caveman-blocks hooks uninstall
stdout '^claude-code: removed from .*/max5/settings.json$'
stdout '^codex: removed from .*/codexhome/hooks.json$'
! grep 'caveman-blocks' max5/settings.json
! exists home/.claude
env CLAUDE_CONFIG_DIR= CODEX_HOME=

# PI_CODING_AGENT_DIR moves pi's agent directory the same way.
env PI_CODING_AGENT_DIR=$WORK/pidir
mkdir pidir
exec caveman-blocks hooks install
stdout '^pi: installed in .*/pidir/extensions/caveman-blocks.js$'
exists pidir/extensions/caveman-blocks.js
exec caveman-blocks hooks uninstall --harness pi
stdout '^pi: removed from .*/pidir/extensions/caveman-blocks.js$'
env PI_CODING_AGENT_DIR=

# A binary running from an npx cache would leave a dangling hook.
cpbin _npx/caveman-blocks
! exec $WORK/_npx/caveman-blocks hooks install
stderr 'install caveman-blocks with install.sh or brew first'
